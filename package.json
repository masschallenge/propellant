{
  "name": "propellant",
  "private": true,
  "type": "module",
  "description": "The Propellant design system documentation site, across every platform.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-platform-docs.mjs",
    "dev": "node scripts/sync-platform-docs.mjs && astro dev",
    "build": "node scripts/sync-platform-docs.mjs && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/react": "7.1.7",
    "@astrojs/starlight": "0.42.6",
    "@masschallenge/propellant-web": "https://codeload.github.com/masschallenge/propellant-web/tar.gz/f8e9eb9d3255107dbd5e12628886116545d88a40",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vitest": "4.1.12"
  }
}
