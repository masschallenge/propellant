---
import { STUDIO_PAGE } from '../../brand/site-pages';
import BrandLayout from '../../layouts/BrandLayout.astro';
import Studio from '../../components/studio/Studio';
---

<BrandLayout
  title={STUDIO_PAGE.title}
  description={STUDIO_PAGE.description}
  current="studio"
>
  <Studio client:only="react" />
  <noscript>
    <p class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6">
      The content studio needs JavaScript to draw your post.
    </p>
  </noscript>
</BrandLayout>
