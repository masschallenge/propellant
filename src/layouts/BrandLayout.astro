---
import '../styles/brand-app.css';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteLockup from '../components/site/SiteLockup.astro';

interface Props {
  title: string;
  description: string;
  current: 'home' | 'brand' | 'studio' | 'signature';
}

const { title, description, current } = Astro.props;

const links = [
  { id: 'brand', label: 'Brand guide', href: '/brand/' },
  { id: 'studio', label: 'Studio', href: '/studio/' },
  { id: 'signature', label: 'Email signature', href: '/studio/signature/' },
  { id: 'web', label: 'Web', href: '/web/' },
  { id: 'office', label: 'Office', href: '/office/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Propellant' ? 'Propellant | MassChallenge' : `${title} | Propellant`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('propellant-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (error) {
        delete document.documentElement.dataset.theme;
      }
    </script>
  </head>
  <body data-propellant data-appearance="system">
    <script is:inline>
      if (document.documentElement.dataset.theme) delete document.body.dataset.appearance;
    </script>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-[var(--corner-md)] focus:bg-[var(--bg)] focus:px-4 focus:py-2"
      >Skip to content</a
    >
    <header
      class="sticky top-0 z-50 border-b border-solid border-[var(--separator)] bg-[var(--bg)]/95 backdrop-blur"
    >
      <div class="mx-auto flex max-w-[1200px] items-center gap-6 px-4 py-3 sm:px-6">
        <a href="/" class="flex shrink-0 items-center text-[var(--label)] no-underline">
          <SiteLockup lightOnlyClass="dark-hidden" darkOnlyClass="light-hidden" />
        </a>
        <nav aria-label="Propellant" class="ml-auto flex min-w-0 items-center gap-1 overflow-x-auto">
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={link.id === current ? 'page' : undefined}
                class="whitespace-nowrap rounded-[var(--corner-md)] px-3 py-2 text-[length:var(--type-callout-size)] font-medium text-[var(--label-secondary)] no-underline hover:bg-[var(--fill-tertiary)] hover:text-[var(--label)] aria-[current=page]:text-[var(--tint)] focus-visible:outline-2 focus-visible:outline-[var(--focus-color)]"
              >
                {link.label}
              </a>
            ))
          }
          <button
            type="button"
            data-theme-toggle
            aria-label="Switch between light and dark"
            class="ml-1 inline-flex h-9 w-9 items-center justify-center rounded-full border border-solid border-[var(--separator-strong)] bg-transparent text-[var(--label)] cursor-pointer hover:bg-[var(--fill-tertiary)] focus-visible:outline-2 focus-visible:outline-[var(--focus-color)]"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"></circle>
              <path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const isDark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        delete document.body.dataset.appearance;
        try {
          localStorage.setItem('propellant-theme', next);
        } catch (error) {
          return;
        }
      });
    </script>
    <style is:global>
      :root:not([data-theme='dark']) .light-hidden {
        display: none;
      }
      :root[data-theme='dark'] .dark-hidden {
        display: none;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) .dark-hidden {
          display: none;
        }
        :root:not([data-theme]) .light-hidden {
          display: block;
        }
      }
    </style>
  </body>
</html>
