---
interface Props {
  tone: 'deep' | 'blue';
  class?: string;
}

const { tone, class: className } = Astro.props;
---

<div
  class:list={[
    'flex items-center justify-center border-2 border-dashed border-white/60 text-[13px] font-semibold uppercase tracking-[0.08em] text-white',
    tone === 'deep' ? 'bg-[var(--brand-deep-teal)]' : 'bg-[var(--brand-mc-blue)]',
    className,
  ]}
>
  Your photo
</div>
