---
type Scene =
  | 'people-first'
  | 'room-to-breathe'
  | 'teal-panel'
  | 'crop-whole'
  | 'logo-calm'
  | 'empty-room'
  | 'busy-text'
  | 'cut-joints'
  | 'stretched'
  | 'filters'
  | 'cliches';

interface Example {
  scene: Scene;
  isApproved: boolean;
  title: string;
  text: string;
}

const EXAMPLES: Example[] = [
  {
    scene: 'people-first',
    isApproved: true,
    title: 'People first',
    text: 'People doing something together: talking, building, pitching, celebrating.',
  },
  {
    scene: 'room-to-breathe',
    isApproved: true,
    title: 'Room to breathe',
    text: 'A calm area, such as a wall or the sky, where a headline or the logo can sit.',
  },
  {
    scene: 'teal-panel',
    isApproved: true,
    title: 'Words on a Deep teal panel',
    text: 'When the photo is busy, put the text on a Deep teal band or panel beside or over it.',
  },
  {
    scene: 'crop-whole',
    isApproved: true,
    title: 'Crop on purpose',
    text: 'Keep heads whole and leave people looking into the page.',
  },
  {
    scene: 'logo-calm',
    isApproved: true,
    title: 'White logo on a dark, calm part',
    text: 'The full color logo goes only on white.',
  },
  {
    scene: 'empty-room',
    isApproved: false,
    title: 'Empty rooms and objects',
    text: 'Empty offices and objects on desks say little about us.',
  },
  {
    scene: 'busy-text',
    isApproved: false,
    title: 'Text on a busy part',
    text: 'Words over a busy patch of a photo are hard to read.',
  },
  {
    scene: 'cut-joints',
    isApproved: false,
    title: 'Cut at the joints',
    text: 'Never crop people at the neck, elbows or knees.',
  },
  {
    scene: 'stretched',
    isApproved: false,
    title: 'Stretched or squashed',
    text: 'Resize from a corner so the photo keeps its proportions.',
  },
  {
    scene: 'filters',
    isApproved: false,
    title: 'Filters and effects',
    text: 'No filters, heavy vignettes, color casts or phone app effects.',
  },
  {
    scene: 'cliches',
    isApproved: false,
    title: 'Stock clichés',
    text: 'No handshakes, light bulbs, puzzle pieces or chess pieces.',
  },
];

const person = (x: number, y: number, scale: number, fill: string) =>
  `<g transform="translate(${x} ${y}) scale(${scale})"><circle cx="0" cy="-26" r="9" fill="${fill}"/><path d="M-15 12 v-14 a15 15 0 0 1 30 0 v14 z" fill="${fill}"/></g>`;

const WALL = 'var(--teal-100)';
const FLOOR = 'var(--teal-150)';
const PERSON_ONE = 'var(--teal-800)';
const PERSON_TWO = 'var(--gray-500)';
const PERSON_THREE = 'var(--teal-600)';
const DEEP = 'var(--teal-900)';
const LIGHT = 'var(--gray-0)';

const room = (inside: string) =>
  `<rect width="160" height="100" fill="${WALL}"/><rect y="78" width="160" height="22" fill="${FLOOR}"/>${inside}`;

const textBars = (x: number, y: number, fill: string) =>
  `<rect x="${x}" y="${y}" width="58" height="7" rx="1.5" fill="${fill}"/><rect x="${x}" y="${y + 11}" width="40" height="7" rx="1.5" fill="${fill}"/>`;

const busyPattern = Array.from({ length: 48 }, (slot, index) => {
  const column = index % 8;
  const line = Math.floor(index / 8);
  const fills = [PERSON_ONE, 'var(--yellow-400)', LIGHT, PERSON_TWO, 'var(--teal-400)'];
  return `<rect x="${column * 20 + (line % 2) * 6}" y="${line * 17}" width="${12 + (index % 3) * 4}" height="${8 + (index % 4) * 3}" rx="2" fill="${fills[index % fills.length]}"/>`;
}).join('');

const SCENES: Record<Scene, string> = {
  'people-first': room(
    `<rect x="54" y="20" width="58" height="36" rx="2" fill="${LIGHT}"/><path d="M62 32 h24 M62 40 h36 M62 48 h18" stroke="${PERSON_TWO}" stroke-width="2"/>${person(40, 74, 1, PERSON_ONE)}${person(122, 74, 1, PERSON_TWO)}${person(84, 86, 0.9, PERSON_THREE)}`,
  ),
  'room-to-breathe': `<rect width="160" height="100" fill="var(--teal-150)"/>${textBars(12, 14, DEEP)}<rect y="70" width="160" height="30" fill="${FLOOR}"/>${person(108, 86, 0.95, PERSON_ONE)}${person(136, 86, 0.95, PERSON_THREE)}`,
  'teal-panel': `<rect width="160" height="100" fill="${WALL}"/>${busyPattern}<rect x="96" width="64" height="100" fill="${DEEP}"/>${textBars(100, 38, LIGHT)}`,
  'crop-whole': room(
    `${person(80, 92, 1.9, PERSON_ONE)}<rect x="40" y="6" width="80" height="90" fill="none" stroke="${DEEP}" stroke-width="1.5" stroke-dasharray="4 3"/>`,
  ),
  'logo-calm': `<rect width="160" height="100" fill="var(--teal-600)"/><rect width="160" height="44" fill="${DEEP}"/><rect x="10" y="12" width="44" height="12" rx="2" fill="none" stroke="${LIGHT}" stroke-width="1.5"/><text x="32" y="21" text-anchor="middle" font-size="7" font-family="var(--type-family)" fill="${LIGHT}">logo</text>${person(70, 96, 1, PERSON_TWO)}${person(110, 96, 1, LIGHT)}`,
  'empty-room': room(
    `<rect x="36" y="56" width="88" height="6" fill="${PERSON_TWO}"/><rect x="44" y="62" width="4" height="18" fill="${PERSON_TWO}"/><rect x="112" y="62" width="4" height="18" fill="${PERSON_TWO}"/><rect x="66" y="40" width="28" height="16" rx="1.5" fill="${DEEP}"/><rect x="104" y="36" width="3" height="20" fill="${PERSON_TWO}"/><path d="M98 36 h14 l-3 -8 h-8 z" fill="var(--yellow-400)"/>`,
  ),
  'busy-text': `<rect width="160" height="100" fill="${WALL}"/>${busyPattern}${textBars(14, 40, LIGHT)}`,
  'cut-joints': room(
    `<g clip-path="url(#cut-frame)">${person(80, 120, 2.6, PERSON_ONE)}</g><rect x="20" y="66" width="120" height="32" fill="none" stroke="var(--magenta-600)" stroke-width="1.5" stroke-dasharray="4 3"/>`,
  ),
  stretched: room(
    `<g transform="translate(80 0) scale(1.9 0.75) translate(-80 0)">${person(80, 100, 1.2, PERSON_ONE)}</g>`,
  ),
  filters: `${room(`${person(60, 86, 1, PERSON_ONE)}${person(100, 86, 1, PERSON_THREE)}`)}<rect width="160" height="100" fill="var(--orange-500)" opacity="0.35"/><rect width="160" height="100" fill="url(#vignette)"/>`,
  cliches: room(
    `<g transform="translate(52 50)"><circle r="16" fill="var(--yellow-400)"/><rect x="-7" y="14" width="14" height="10" rx="2" fill="${PERSON_TWO}"/></g><path d="M92 36 h14 a5 5 0 1 1 10 0 h14 v14 a5 5 0 1 0 0 10 v14 h-38 z" fill="${PERSON_THREE}"/>`,
  ),
};

const DEFINITIONS = `<defs><clipPath id="cut-frame"><rect x="20" y="66" width="120" height="32"/></clipPath><radialGradient id="vignette"><stop offset="0.45" stop-color="black" stop-opacity="0"/><stop offset="1" stop-color="black" stop-opacity="0.75"/></radialGradient></defs>`;
---

<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
  <Fragment set:html={DEFINITIONS} />
</svg>
<ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
  {
    EXAMPLES.map((example) => (
      <li class="flex flex-col overflow-hidden rounded-[var(--corner-lg)] border border-solid border-[var(--separator)] bg-[var(--bg)]">
        <svg
          viewBox="0 0 160 100"
          role="img"
          aria-label={`${example.isApproved ? 'Approved' : 'Not approved'}: ${example.title}. Diagram.`}
          class="block aspect-[16/10] w-full"
        >
          <Fragment set:html={SCENES[example.scene]} />
        </svg>
        <div class="flex flex-col gap-1 p-4">
          <p
            class:list={[
              'm-0 inline-flex items-center gap-1.5 text-[length:var(--type-footnote-size)] font-bold uppercase tracking-[var(--type-eyebrow-tracking)]',
              example.isApproved ? 'text-[var(--success)]' : 'text-[var(--critical)]',
            ]}
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              {example.isApproved ? <path d="M5 12.5l4.5 4.5L19 7.5" /> : <path d="M6 6l12 12M18 6L6 18" />}
            </svg>
            {example.isApproved ? 'Do' : "Don't"}
          </p>
          <p class="m-0 text-[length:var(--type-headline-size)] font-semibold text-[var(--label)]">
            {example.title}
          </p>
          <p class="m-0 text-[length:var(--type-subheadline-size)] text-[var(--label-secondary)]">
            {example.text}
          </p>
        </div>
      </li>
    ))
  }
</ul>
