---
import {
  ENDORSEMENT_EXAMPLE,
  HEXAGON_FRAME,
  ICON_SURFACES,
  PARTNER_LOCKUPS,
  PATTERN_COVERS,
  STAT_CALLOUTS,
  SUB_BRAND_LOCKUPS,
  TIMELINE_LINE_HEX,
  hexagonPoints,
  timelineSteps,
} from '../../../brand/device-examples';
import type { GraphicDeviceId } from '../../../brand/graphic-devices';
import { heroOverlayCss } from '../../../brand/imagery';
import { findColor } from '../../../brand/palette';
import { trianglePattern } from '../../../studio/patterns';
import { LOGO_FILES } from './logoFiles';

interface Props {
  deviceId: GraphicDeviceId;
}

const { deviceId } = Astro.props;

const COVER_WIDTH = 768;
const COVER_HEIGHT = 432;
const coverTriangles = trianglePattern(COVER_WIDTH, COVER_HEIGHT);
const pointList = (points: [number, number][]) =>
  points.map(([horizontal, vertical]) => `${horizontal},${vertical}`).join(' ');

const TIMELINE_WIDTH = 780;
const TIMELINE_HEIGHT = 180;
const TIMELINE_MARGIN = 85;
const steps = timelineSteps();
const stepGap = (TIMELINE_WIDTH - TIMELINE_MARGIN * 2) / (steps.length - 1);

const ICONS = [
  {
    name: 'Founders',
    paths: ['M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z', 'M4 21c0-4 3.6-6 8-6s8 2 8 6'],
  },
  {
    name: 'Experts',
    paths: [
      'M9 18h6',
      'M10 21h4',
      'M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z',
    ],
  },
  {
    name: 'Collaborators',
    paths: [
      'M9 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z',
      'M2.5 20c0-3.5 3-5.5 6.5-5.5s6.5 2 6.5 5.5',
      'M17 11.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
      'M16.5 14.6c2.8.2 5 2 5 4.9',
    ],
  },
  {
    name: 'Global network',
    paths: [
      'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z',
      'M3 12h18',
      'M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z',
    ],
  },
];

const OVERLAY_SIDES = ['left', 'bottom'] as const;
const WARM_STAND_IN = 'linear-gradient(160deg, #F2C9A0 0%, #C98B5A 45%, #6B4A3A 100%)';
const HEXAGON_NODES = [
  { x: 52, y: 52, radius: 22 },
  { x: 312, y: 44, radius: 18 },
  { x: 40, y: 186, radius: 16 },
  { x: 318, y: 190, radius: 24 },
  { x: 268, y: 116, radius: 12 },
  { x: 96, y: 128, radius: 10 },
];

const FRAME =
  'flex aspect-[3/2] items-center justify-center overflow-hidden rounded-[var(--corner-lg)] border border-solid border-[var(--separator)]';
const LIST = 'm-0 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2';
---

{
  deviceId === 'pattern' ? (
    <ul class={LIST}>
      {PATTERN_COVERS.map((cover) => (
        <li class="m-0">
          <div class={FRAME}>
            <svg
              viewBox={`0 0 ${COVER_WIDTH} ${COVER_HEIGHT}`}
              role="img"
              aria-label={cover.alt}
              class="block h-full w-full"
              preserveAspectRatio="xMidYMid slice"
            >
              {coverTriangles.map((triangle) => (
                <polygon points={pointList(triangle.points)} fill={findColor(triangle.colorId).hex} />
              ))}
              {cover.panelColorId ? (
                <rect
                  x={COVER_WIDTH / 2 - 250}
                  y={COVER_HEIGHT / 2 - 70}
                  width="500"
                  height="140"
                  fill={findColor(cover.panelColorId).hex}
                />
              ) : null}
              <text
                x={COVER_WIDTH / 2}
                y={COVER_HEIGHT / 2}
                text-anchor="middle"
                dominant-baseline="central"
                font-size="84"
                font-weight="600"
                fill={findColor(cover.labelColorId).hex}
                style="font-family: var(--type-family-brand)"
              >
                {cover.label}
              </text>
            </svg>
          </div>
        </li>
      ))}
    </ul>
  ) : deviceId === 'hero-overlay' ? (
    <ul class={LIST}>
      {OVERLAY_SIDES.map((side) => (
        <li class="m-0">
          <div
            class={`${FRAME} items-end justify-start p-6`}
            style={`background: ${heroOverlayCss(side)}, ${WARM_STAND_IN}`}
            role="img"
            aria-label={`A diagram of the hero overlay over a warm photo, dark on the ${side} where the words sit and clear toward the subject`}
          >
            <span class="font-[family-name:var(--type-family-brand)] text-[length:var(--type-title1-size)] font-semibold uppercase leading-none" style={`color: ${findColor('white').hex}`} aria-hidden="true">
              Headline
            </span>
          </div>
        </li>
      ))}
    </ul>
  ) : deviceId === 'hexagon-frame' ? (
    <div class={FRAME} style={`background: ${findColor(HEXAGON_FRAME.surfaceColorId).hex}`}>
      <svg viewBox="0 0 360 240" role="img" aria-label="A diagram of a circular photo crop inside a network of MC Blue hexagons joined by light tint lines" class="block h-full w-full">
        {HEXAGON_NODES.map((node) => (
          <line x1="180" y1="120" x2={node.x} y2={node.y} stroke={findColor(HEXAGON_FRAME.lineColorId).hex} stroke-width="2" />
        ))}
        {HEXAGON_NODES.map((node) => (
          <polygon points={hexagonPoints(node.x, node.y, node.radius)} fill={findColor(HEXAGON_FRAME.hexagonColorId).hex} />
        ))}
        <circle cx="180" cy="120" r="78" fill="none" stroke={findColor(HEXAGON_FRAME.hexagonColorId).hex} stroke-width="4" />
        <circle cx="180" cy="120" r="70" fill="url(#hexagon-photo)" />
        <defs>
          <linearGradient id="hexagon-photo" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#E7C7A4" />
            <stop offset="1" stop-color="#7A5444" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  ) : deviceId === 'partner-lockup' ? (
    <ul class={LIST}>
      {PARTNER_LOCKUPS.map((lockup) => (
        <li class="m-0">
          <div
            class={`${FRAME} gap-5 p-6`}
            style={`background: ${findColor(lockup.surfaceColorId).hex}; color: ${findColor(lockup.textColorId).hex}`}
            role="img"
            aria-label="A diagram of the corporate partner lockup: the partner logo first, a thin vertical rule, then the MassChallenge vertical logo"
          >
            <span class="flex h-20 w-24 items-center justify-center border border-dashed border-current p-2 text-center text-[length:var(--type-caption-size)] font-semibold" aria-hidden="true">
              Partner logo
            </span>
            <span aria-hidden="true" class="block h-24 w-px" style={`background: ${findColor(lockup.ruleColorId).hex}`} />
            <span class="flex h-20 w-24 items-center justify-center border border-dashed border-current p-2 text-center text-[length:var(--type-caption-size)] font-semibold" aria-hidden="true">
              MassChallenge vertical logo
            </span>
          </div>
        </li>
      ))}
    </ul>
  ) : deviceId === 'sub-brand-lockup' ? (
    <ul class={LIST}>
      {SUB_BRAND_LOCKUPS.map((lockup) => (
        <li class="m-0">
          <div
            class={`${FRAME} gap-4 p-6`}
            style={`background: ${findColor(lockup.surfaceColorId).hex}`}
            role="img"
            aria-label={`A diagram of the sub-brand lockup structure on ${findColor(lockup.surfaceColorId).name}: the MC mark, a ${findColor(lockup.ruleColorId).name} rule, the program name and the location`}
          >
            <img src={LOGO_FILES.monogram[lockup.monogramTreatment]} alt="" class="block h-10 w-auto" />
            <span aria-hidden="true" class="block h-12 w-0.5" style={`background: ${findColor(lockup.ruleColorId).hex}`} />
            <span class="flex flex-col gap-1" style={`color: ${findColor(lockup.textColorId).hex}`} aria-hidden="true">
              <span class="font-[family-name:var(--type-family-brand)] text-[length:var(--type-title2-size)] font-semibold uppercase leading-none">
                {lockup.name}
              </span>
              <span class="font-[family-name:var(--type-family-brand)] text-[length:var(--type-caption-size)] uppercase leading-none tracking-[0.3em]">
                {lockup.location}
              </span>
            </span>
          </div>
        </li>
      ))}
    </ul>
  ) : deviceId === 'partner-endorsement' ? (
    <div
      class={`${FRAME} justify-start p-8`}
      style={`background: ${findColor(ENDORSEMENT_EXAMPLE.surfaceColorId).hex}; color: ${findColor(ENDORSEMENT_EXAMPLE.textColorId).hex}`}
      role="img"
      aria-label="A diagram of the partner initiative endorsement: the initiative name above a thin rule, with WITH MASSCHALLENGE below, left aligned"
    >
      <span class="flex flex-col items-start gap-2" aria-hidden="true">
        <span class="font-[family-name:var(--type-family-brand)] text-[length:var(--type-title1-size)] font-semibold uppercase leading-none">
          {ENDORSEMENT_EXAMPLE.initiative}
        </span>
        <span class="block h-px w-full bg-current" />
        <span class="font-[family-name:var(--type-family-brand)] text-[length:var(--type-caption-size)] uppercase tracking-[0.3em]">
          {ENDORSEMENT_EXAMPLE.endorsement}
        </span>
      </span>
    </div>
  ) : deviceId === 'stat-callout' ? (
    <ul class={LIST}>
      {STAT_CALLOUTS.map((stat) => (
        <li class="m-0">
          <div
            class={`${FRAME} flex-col gap-2 p-6`}
            style={`background: ${findColor(stat.surfaceColorId).hex}`}
          >
            <span
              class="font-[family-name:var(--type-family-brand)] text-[length:var(--type-large-title-size)] font-bold uppercase leading-none"
              style={`color: ${findColor(stat.numberColorId).hex}; font-size: 4.5rem`}
            >
              {stat.value}
            </span>
            {stat.accentRuleColorId ? (
              <span aria-hidden="true" class="block h-1 w-12" style={`background: ${findColor(stat.accentRuleColorId).hex}`} />
            ) : null}
            <span
              class="text-[length:var(--type-headline-size)] font-bold tracking-[0.04em]"
              style={`color: ${findColor(stat.labelColorId).hex}`}
            >
              {stat.label}
            </span>
          </div>
        </li>
      ))}
    </ul>
  ) : deviceId === 'timeline' ? (
    <div
      class="overflow-x-auto rounded-[var(--corner-lg)] border border-solid border-[var(--separator)] p-2 focus-visible:outline-[length:var(--focus-width)] focus-visible:outline-solid focus-visible:outline-[var(--focus-color)]"
      style={`background: ${findColor('white').hex}`}
      tabindex="0"
      role="region"
      aria-label="Program timeline example, scrolls sideways on small screens"
    >
      <svg
        viewBox={`0 0 ${TIMELINE_WIDTH} ${TIMELINE_HEIGHT}`}
        role="img"
        aria-label={`A program timeline: ${steps.map((step) => step.name).join(', ')}, as dots on a line in the chart colors`}
        class="block h-auto w-full min-w-[560px]"
      >
        <line
          x1={TIMELINE_MARGIN}
          x2={TIMELINE_WIDTH - TIMELINE_MARGIN}
          y1={TIMELINE_HEIGHT / 2}
          y2={TIMELINE_HEIGHT / 2}
          stroke={TIMELINE_LINE_HEX}
          stroke-width="3"
        />
        {steps.map((step, index) => (
          <g>
            <circle
              cx={TIMELINE_MARGIN + stepGap * index}
              cy={TIMELINE_HEIGHT / 2}
              r="11"
              fill={step.hex}
              stroke={findColor('black').hex}
              stroke-width="1.5"
            />
            <text
              x={TIMELINE_MARGIN + stepGap * index}
              y={step.isAbove ? TIMELINE_HEIGHT / 2 - 30 : TIMELINE_HEIGHT / 2 + 42}
              text-anchor="middle"
              font-size="16"
              font-weight="700"
              fill={findColor('black').hex}
              style="font-family: var(--type-family)"
            >
              {step.name}
            </text>
          </g>
        ))}
      </svg>
    </div>
  ) : deviceId === 'icons' ? (
    <ul class={LIST}>
      {ICON_SURFACES.map((surface) => (
        <li class="m-0">
          <div
            class={`${FRAME} p-6`}
            style={`background: ${findColor(surface.surfaceColorId).hex}`}
          >
            <ul class="m-0 grid list-none grid-cols-2 gap-5 p-0">
              {ICONS.map((icon) => (
                <li class="m-0 flex items-center gap-2">
                  <svg
                    viewBox="0 0 24 24"
                    width="32"
                    height="32"
                    fill="none"
                    stroke={findColor(surface.iconColorId).hex}
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {icon.paths.map((path) => (
                      <path d={path} />
                    ))}
                  </svg>
                  <span
                    class="text-[length:var(--type-callout-size)] font-semibold"
                    style={`color: ${findColor(surface.labelColorId).hex}`}
                  >
                    {icon.name}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  ) : null
}
