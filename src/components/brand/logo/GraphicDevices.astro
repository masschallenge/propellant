---
import { GRAPHIC_DEVICES } from '../../../brand/graphic-devices';
import DeviceExample from './DeviceExample.astro';
---

<div class="flex flex-col gap-6">
  {
    GRAPHIC_DEVICES.map((device) => (
      <article
        id={`device-${device.id}`}
        class="grid gap-5 rounded-[var(--corner-xl)] border border-solid border-[var(--separator)] bg-[var(--bg)] p-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]"
      >
        <div class="flex flex-col gap-2">
          <h4 class="m-0 text-[length:var(--type-title3-size)] font-semibold text-[var(--label)]">
            {device.name}
          </h4>
          <p class="m-0 text-[length:var(--type-callout-size)] leading-[var(--type-callout-line)] text-[var(--label)]">
            {device.description}
          </p>
          <p class="m-0 text-[length:var(--type-callout-size)] leading-[var(--type-callout-line)] text-[var(--label-secondary)]">
            <strong class="font-semibold text-[var(--label)]">Use it for:</strong> {device.use}
          </p>
          {device.note ? (
            <p class="m-0 rounded-[var(--corner-md)] bg-[var(--bg-secondary)] p-3 text-[length:var(--type-footnote-size)] leading-[var(--type-footnote-line)] text-[var(--label)]">
              {device.note}
            </p>
          ) : null}
        </div>
        <DeviceExample deviceId={device.id} />
      </article>
    ))
  }
</div>
