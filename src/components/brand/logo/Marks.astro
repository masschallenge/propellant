---
import propellantMarkColor from '../../../assets/brand/propellant-mark-color.svg';
import propellantMarkWhite from '../../../assets/brand/propellant-mark-white.svg';
import { LOGO_FILES } from './logoFiles';

const marks = [
  {
    id: 'horizontal',
    name: 'MassChallenge horizontal lockup',
    note: 'The MC mark, a thin divider and the MASSCHALLENGE wordmark. Keep the three parts together, at the proportions in the files. Never rearrange them.',
  },
  {
    id: 'monogram',
    name: 'MassChallenge MC mark',
    note: 'The MC mark on its own, only where the audience already knows us, such as compact navigation, favicons, avatars and app icons.',
  },
];
---

<div class="grid gap-4 md:grid-cols-3">
  {
    marks.map((mark) => (
      <article class="flex flex-col overflow-hidden rounded-[var(--corner-xl)] border border-solid border-[var(--separator)] bg-[var(--bg)]">
        <div class="flex h-40 items-center justify-center bg-[var(--gray-0)] p-6">
          <img
            src={LOGO_FILES[mark.id as 'horizontal' | 'monogram'].color}
            alt={mark.name}
            class:list={['w-auto max-w-full', mark.id === 'horizontal' ? 'h-9' : 'h-14']}
          />
        </div>
        <div class="flex flex-col gap-2 p-5">
          <h4 class="m-0 text-[length:var(--type-title3-size)] font-semibold text-[var(--label)]">{mark.name}</h4>
          <p class="m-0 text-[length:var(--type-callout-size)] leading-[var(--type-callout-line)] text-[var(--label-secondary)]">
            {mark.note}
          </p>
        </div>
      </article>
    ))
  }
  <article
    class="flex flex-col overflow-hidden rounded-[var(--corner-xl)] border border-dashed border-[var(--separator-strong)] bg-[var(--bg)]"
  >
    <div class="flex h-40 items-center justify-center bg-[var(--bg-secondary)] p-6">
      <img src={propellantMarkColor.src} alt="Propellant mark" class="dark-hidden h-24 w-auto" />
      <img src={propellantMarkWhite.src} alt="Propellant mark" class="light-hidden h-24 w-auto" />
    </div>
    <div class="flex flex-col gap-2 p-5">
      <div class="flex flex-wrap items-center gap-2">
        <h4 class="m-0 text-[length:var(--type-title3-size)] font-semibold text-[var(--label)]">
          Propellant mark
        </h4>
        <span
          class="inline-flex min-h-5 items-center rounded-full border border-solid border-[var(--separator-strong)] px-2 text-[length:var(--type-caption-size)] font-semibold text-[var(--label-secondary)]"
          >Design system only</span
        >
      </div>
      <p
        class="m-0 text-[length:var(--type-callout-size)] leading-[var(--type-callout-line)] text-[var(--label-secondary)]"
      >
        It stands for the design system and nothing else: its documentation, Storybook, the
        repository and the package. Never use it in place of the MassChallenge logo, and never place
        the two so they read as one.
      </p>
    </div>
  </article>
</div>
