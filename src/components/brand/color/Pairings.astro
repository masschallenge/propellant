---
import { isDark } from '../../../brand/contrast';
import {
  APPROVED_PAIRINGS,
  FAILING_PAIRINGS,
  VERIFIED_PAIRINGS,
  resolvePairings,
} from '../../../brand/pairings';

const approved = resolvePairings(APPROVED_PAIRINGS);
const verified = resolvePairings(VERIFIED_PAIRINGS);
const failing = resolvePairings(FAILING_PAIRINGS);
const describe = (pairing: (typeof approved)[number]) =>
  `${pairing.foreground.name} on ${pairing.background.name}`;
---

<ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
  {
    approved.map((pairing) => (
      <li
        class="flex min-h-[160px] flex-col justify-between gap-4 rounded-[var(--corner-xl)] border border-solid border-[var(--separator)] p-5"
        style={`background: ${pairing.background.hex}; color: ${pairing.foreground.hex}`}
      >
        <span class="font-[family-name:var(--type-family-brand)] text-[length:var(--type-title1-size)] font-semibold uppercase leading-none">
          {pairing.foreground.name}
        </span>
        <span
          class:list={[
            'flex items-baseline justify-between gap-3 text-[length:var(--type-callout-size)]',
            isDark(pairing.background.hex) ? 'text-[var(--gray-0)]' : 'text-[var(--gray-800)]',
          ]}
        >
          <span>{describe(pairing)}</span>
          <span class="font-semibold tabular-nums">{pairing.label}</span>
        </span>
      </li>
    ))
  }
</ul>

<div class="mt-6 grid gap-4 md:grid-cols-2">
  <article class="rounded-[var(--corner-xl)] border border-solid border-[var(--separator)] bg-[var(--bg)] p-5">
    <h4 class="m-0 mb-3 text-[length:var(--type-headline-size)] font-semibold text-[var(--label)]">Also verified</h4>
    <ul class="m-0 flex list-none flex-col gap-2 p-0">
      {
        verified.map((pairing) => (
          <li class="flex items-center gap-3 text-[length:var(--type-callout-size)] text-[var(--label)]">
            <span
              class="inline-flex h-8 w-12 flex-none items-center justify-center rounded-[var(--corner-sm)] border border-solid border-[var(--separator-strong)] font-semibold"
              style={`background: ${pairing.background.hex}; color: ${pairing.foreground.hex}`}
              aria-hidden="true"
            >
              Aa
            </span>
            <span class="flex-1">{describe(pairing)}</span>
            <span class="tabular-nums text-[var(--label-secondary)]">{pairing.label}</span>
          </li>
        ))
      }
    </ul>
  </article>
  <article class="rounded-[var(--corner-xl)] border border-solid border-[var(--critical)] bg-[var(--critical-fill)] p-5">
    <h4 class="m-0 mb-3 text-[length:var(--type-headline-size)] font-semibold text-[var(--label)]">Never for text</h4>
    <ul class="m-0 flex list-none flex-col gap-2 p-0">
      {
        failing.map((pairing) => (
          <li class="flex items-center gap-3 text-[length:var(--type-callout-size)] text-[var(--label)]">
            <span
              class="inline-flex h-8 w-12 flex-none items-center justify-center rounded-[var(--corner-sm)] border border-solid border-[var(--separator-strong)] font-semibold"
              style={`background: ${pairing.background.hex}; color: ${pairing.foreground.hex}`}
              aria-hidden="true"
            >
              Aa
            </span>
            <span class="flex-1">{describe(pairing)}</span>
            <span class="tabular-nums text-[var(--label-secondary)]">{pairing.label}, fails</span>
          </li>
        ))
      }
    </ul>
  </article>
</div>
