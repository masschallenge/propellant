---
import { isDark } from '../../../brand/contrast';
import { BRAND_COLORS } from '../../../brand/palette';
import { pairingsOn } from '../../../brand/pairings';

const cards = BRAND_COLORS.map((background) => {
  const isDarkBackground = isDark(background.hex);
  return {
    background,
    groups: pairingsOn(background),
    chrome: isDarkBackground ? 'text-[var(--gray-0)]' : 'text-[var(--gray-800)]',
  };
});
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    cards.map((card) => (
      <article
        class:list={[
          'flex flex-col gap-4 rounded-[var(--corner-xl)] border border-solid border-[var(--separator)] p-5',
          card.chrome,
        ]}
        style={`background: ${card.background.hex}`}
        aria-labelledby={`pairing-${card.background.id}`}
      >
        <header>
          <p class="m-0 text-[length:var(--type-caption-size)] font-bold uppercase tracking-[0.1em] opacity-80">
            Background
          </p>
          <h4 id={`pairing-${card.background.id}`} class="m-0 text-[length:var(--type-title2-size)] font-semibold">
            {card.background.name}
          </h4>
        </header>

        {card.groups.any.length ? (
          <div>
            <p class="m-0 mb-2 text-[length:var(--type-footnote-size)] font-bold">Any text, any size</p>
            <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
              {card.groups.any.map((pairing) => (
                <li class="flex items-baseline gap-3">
                  <span
                    class="w-10 flex-none text-[length:var(--type-title2-size)] font-semibold leading-none"
                    style={`color: ${pairing.color.hex}`}
                    aria-hidden="true"
                  >
                    Aa
                  </span>
                  <span class="flex-1 text-[length:var(--type-callout-size)]">{pairing.color.name}</span>
                  <span class="text-[length:var(--type-footnote-size)] tabular-nums opacity-80">{pairing.label}</span>
                </li>
              ))}
            </ul>
          </div>
        ) : null}

        {card.groups.large.length ? (
          <div class:list={['border-t border-solid pt-3', 'border-current/25']}>
            <p class="m-0 mb-2 text-[length:var(--type-footnote-size)] font-bold">Headlines and graphics only</p>
            <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
              {card.groups.large.map((pairing) => (
                <li class="flex items-baseline gap-3">
                  <span
                    class="w-10 flex-none text-[length:var(--type-title1-size)] font-bold leading-none"
                    style={`color: ${pairing.color.hex}`}
                    aria-hidden="true"
                  >
                    Aa
                  </span>
                  <span class="flex-1 text-[length:var(--type-callout-size)]">{pairing.color.name}</span>
                  <span class="text-[length:var(--type-footnote-size)] tabular-nums opacity-80">{pairing.label}</span>
                </li>
              ))}
            </ul>
          </div>
        ) : null}

        {card.groups.never.length ? (
          <div class:list={['mt-auto border-t border-solid pt-3', 'border-current/25']}>
            <p class="m-0 mb-2 text-[length:var(--type-footnote-size)] font-bold">Never on {card.background.name.toLowerCase()}</p>
            <ul class="m-0 flex list-none flex-wrap gap-x-3 gap-y-1.5 p-0">
              {card.groups.never.map((pairing) => (
                <li class="flex items-center gap-1.5 text-[length:var(--type-footnote-size)]">
                  <span
                    class:list={['h-3 w-3 flex-none rounded-full border border-solid', 'border-current/25']}
                    style={`background: ${pairing.color.hex}`}
                    aria-hidden="true"
                  />
                  <span>
                    {pairing.color.name} <span class="tabular-nums opacity-80">{pairing.label}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ) : null}
      </article>
    ))
  }
</div>
