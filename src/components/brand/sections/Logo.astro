---
import SectionHeading from '../SectionHeading.astro';
import LogoCards from '../logo/LogoCards';
import ClearSpaceTool from '../logo/ClearSpaceTool';
import MisuseGrid from '../logo/MisuseGrid.astro';
import Marks from '../logo/Marks.astro';
import GraphicDevices from '../logo/GraphicDevices.astro';
import SubHeading from '../logo/SubHeading.astro';
import { LOGO_FILES } from '../logo/logoFiles';
import {
  LOGO_LOCKUPS,
  LOGO_NEVER,
  LOGO_VERSIONS,
  MARKETING_FILES_NOTE,
  minimumLabel,
} from '../../../brand/logo-usage';

const fileColumns = [
  {
    id: 'png',
    title: 'PNG',
    tag: 'Files',
    body: 'For documents, slides and anything you make outside the code. The horizontal logo and the MC mark come in full color, white and black. Download them from the cards above. Vertical and local logo files come from MassChallenge Marketing.',
  },
  {
    id: 'component',
    title: 'The Logo component',
    tag: 'Code',
    body: 'In a product built with Propellant. It renders at 24px tall by default; size it with a height class such as h-8 and the width follows.',
    code: ['<Logo />', '<Logo treatment="white" />', '<Logo lockup="monogram" />'],
  },
  {
    id: 'never',
    title: 'Screenshots and copies',
    tag: 'Never',
    body: 'A screenshot of the logo, a copy pulled off a website, or one lifted out of an old document. Download it fresh from this page instead.',
  },
];
---

<section id="logo" class="scroll-mt-28 py-16">
  <SectionHeading
    eyebrow="Logo"
    title="Logo"
    lead="Use the supplied files or the Logo component. Never recolor, stretch, rotate, outline, flip, crop, rebuild or retype it. Pick a background on a card and the logo switches to the right treatment for it."
  />

  <LogoCards client:visible />

  <SubHeading
    id="logo-versions"
    title="Which version?"
    lead={MARKETING_FILES_NOTE}
  />
  <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
    {
      LOGO_VERSIONS.map((version) => (
        <li
          class:list={[
            'flex flex-col gap-2 rounded-[var(--corner-xl)] border p-5',
            version.isShipped
              ? 'border-solid border-[var(--separator)] bg-[var(--bg)]'
              : 'border-dashed border-[var(--separator-strong)] bg-[var(--bg)]',
          ]}
        >
          <p class="m-0 text-[length:var(--type-footnote-size)] font-bold uppercase tracking-[0.08em] text-[var(--label-secondary)]">
            {version.isShipped ? 'In Propellant' : 'From MassChallenge Marketing'}
          </p>
          <h4 class="m-0 text-[length:var(--type-title3-size)] font-semibold text-[var(--label)]">{version.name}</h4>
          <p class="m-0 text-[length:var(--type-callout-size)] leading-[var(--type-callout-line)] text-[var(--label-secondary)]">
            {version.use}
          </p>
          {version.screenMinimum ? (
            <p class="m-0 mt-auto text-[length:var(--type-footnote-size)] text-[var(--label)]">
              At least {version.screenMinimum} on screen, {version.printMinimum} in print.
            </p>
          ) : null}
        </li>
      ))
    }
  </ul>

  <SubHeading id="logo-files" title="Which file do I use?" />
  <div class="grid gap-4 md:grid-cols-3">
    {
      fileColumns.map((column) => (
        <article
          class:list={[
            'flex flex-col gap-3 rounded-[var(--corner-xl)] border border-solid p-5',
            column.id === 'never'
              ? 'border-[var(--critical)] bg-[var(--critical-fill)]'
              : 'border-[var(--separator)] bg-[var(--bg)]',
          ]}
        >
          <p
            class:list={[
              'm-0 flex items-center gap-1.5 text-[length:var(--type-footnote-size)] font-bold uppercase tracking-[0.08em]',
              column.id === 'never' ? 'text-[var(--critical)]' : 'text-[var(--tint)]',
            ]}
          >
            {
              column.id === 'never' ? (
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" />
                </svg>
              ) : null
            }
            {column.tag}
          </p>
          <h4 class="m-0 text-[length:var(--type-title3-size)] font-semibold text-[var(--label)]">
            {column.title}
          </h4>
          <p class="m-0 text-[length:var(--type-body-size)] leading-[var(--type-body-line)] text-[var(--label-secondary)]">
            {column.body}
          </p>
          {
            column.code ? (
              <pre class="m-0 overflow-x-auto rounded-[var(--corner-md)] bg-[var(--bg-secondary)] p-3 font-[family-name:var(--type-family-mono)] text-[length:var(--type-footnote-size)] text-[var(--label)]"><code>{column.code.join('\n')}</code></pre>
            ) : null
          }
        </article>
      ))
    }
  </div>

  <SubHeading
    id="logo-room"
    title="Give it room"
    lead="The clear space on every side equals the height of the M in the MASSCHALLENGE wordmark. Nothing enters it: no type, images, edges or other logos. The MC mark keeps clear space of half its height. Move the slider to see it."
  />
  <ClearSpaceTool client:visible />

  <SubHeading
    id="logo-size"
    title="Not too small"
    lead="These are the smallest sizes on screen, shown at actual size. Below them, the slider above shows a warning."
  />
  <div class="grid gap-4 sm:grid-cols-2">
    {
      LOGO_LOCKUPS.map((lockup) => (
        <article class="flex flex-col gap-4 rounded-[var(--corner-xl)] border border-solid border-[var(--separator)] bg-[var(--bg)] p-5">
          <div class="flex h-28 items-center justify-center rounded-[var(--corner-lg)] bg-[var(--gray-0)]">
            <img
              src={LOGO_FILES[lockup.id].color}
              alt={`MassChallenge ${lockup.name} logo at ${minimumLabel(lockup)}`}
              style={`height: ${lockup.minimumHeight}px`}
              class="block w-auto"
            />
          </div>
          <div>
            <p class="m-0 text-[length:var(--type-footnote-size)] text-[var(--label-secondary)]">
              {lockup.name}
            </p>
            <p class="m-0 text-[length:var(--type-title1-size)] font-bold tabular-nums text-[var(--label)]">
              {minimumLabel(lockup)}
            </p>
            <p class="m-0 mt-1 text-[length:var(--type-callout-size)] text-[var(--label-secondary)]">
              {lockup.minimumNote}
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <SubHeading
    id="logo-misuse"
    title="Please don't"
    lead="Each of these is the real logo, changed with a few lines of CSS to show what to avoid. Never create new lockups or sub-logos outside the sub-brand system."
  />
  <MisuseGrid />
  <div class="mt-4 rounded-[var(--corner-xl)] border border-solid border-[var(--separator)] bg-[var(--bg)] p-5">
    <h4 class="m-0 mb-2 text-[length:var(--type-headline-size)] font-semibold text-[var(--label)]">Never</h4>
    <ul class="m-0 grid gap-x-6 gap-y-1 pl-5 text-[length:var(--type-callout-size)] text-[var(--label)] sm:grid-cols-2">
      {LOGO_NEVER.map((rule) => <li>{rule}</li>)}
    </ul>
  </div>

  <SubHeading
    id="marks"
    title="Marks"
    lead="The two MassChallenge logo files Propellant ships, and the Propellant mark, which belongs to the design system."
  />
  <Marks />

  <SubHeading
    id="graphic-devices"
    title="Graphic devices"
    lead="The shapes, frames and treatments that make MassChallenge work recognizable. Build them from the palette and the logo files."
  />
  <GraphicDevices />
</section>
