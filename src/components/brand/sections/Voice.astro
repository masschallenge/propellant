---
import SectionHeading from '../SectionHeading.astro';
import SubHeading from '../logo/SubHeading.astro';
import VoicePairs from '../voice/VoicePairs';
import VoiceChecker from '../voice/VoiceChecker';

const pairs = [
  {
    avoid: "Leverage our seamless platform to unlock your startup's full potential!",
    write: 'Find mentors who know your market.',
  },
  {
    avoid: 'Users must complete all required fields prior to submission.',
    write: 'Add your company website to submit your application.',
  },
  {
    avoid: 'Oops! Something went wrong.',
    write: 'We could not save your changes. Check your connection and try again.',
  },
];

const principles = [
  { key: 'Get to the point.', rest: 'Short sentences and everyday words.' },
  { key: 'Write as a person.', rest: 'We for MassChallenge, you for the person reading.' },
  { key: 'Confident, no hype.', rest: 'No buzzwords, no exclamation marks.' },
  { key: 'Verbs on buttons.', rest: 'Save changes, Submit application.' },
];
---

<section id="voice" class="scroll-mt-28 py-16">
  <SectionHeading
    eyebrow="Voice"
    title="Voice"
    lead="MassChallenge sounds bold and human: direct, plain spoken and on the side of the community we serve. In a product, keep the confidence and drop the slogans."
  />

  <ul class="m-0 mb-10 grid list-none gap-3 p-0 sm:grid-cols-2 lg:grid-cols-4">
    {
      principles.map((principle) => (
        <li class="rounded-[var(--corner-lg)] bg-[var(--bg-secondary)] p-4 text-[length:var(--type-callout-size)] text-[var(--label-secondary)]">
          <strong class="block text-[length:var(--type-headline-size)] font-semibold text-[var(--label)]">
            {principle.key}
          </strong>
          {principle.rest}
        </li>
      ))
    }
  </ul>

  <SubHeading id="voice-pairs" title="Don't write, write" lead="Straight from the brand guidelines. Press a card to flip it." />
  <VoicePairs client:visible pairs={pairs} />

  <SubHeading
    id="voice-checker"
    title="Check your words"
    lead="It flags buzzwords, exclamation marks, dashes, Oops, Title Case in short labels, MC used as a word, and MassChallenge spelled wrongly. It is a helper, not a judge: read the flag and decide."
  />
  <VoiceChecker client:visible />
</section>
